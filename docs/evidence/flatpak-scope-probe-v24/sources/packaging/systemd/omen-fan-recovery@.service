[Unit]
Description=OMEN experimental Automatic/Maximum recovery writer (%i)
Documentation=file:///usr/share/doc/omen-linux/FAN_MODES.md
# Deliberately independent of omen-linux.service: no PartOf/BindsTo or shared cgroup.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/omen-daemon --coarse-recovery --instance %i
Restart=on-failure
RestartSec=250ms
RuntimeDirectory=omen-fan-recovery
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
BindReadOnlyPaths=/sys
# The sole writable hardware attribute. %i is validated as hwmon + digits.
BindPaths=/sys/devices/platform/hp-wmi/hwmon/%i/pwm1_enable
ReadWritePaths=/run/omen-fan-recovery
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictSUIDSGID=yes
# No [Install] section: never enabled or started by package hooks.
