+#[derive(Clone, Copy)]
+enum SetupAction {
+    Check,
+    Install,
+    Remove,
+}
+
+struct FlatpakMode {
+    active: Rc<std::cell::Cell<bool>>,
+    ready: Rc<std::cell::Cell<bool>>,
+    supported: bool,
+}
+
+fn flatpak_controls(
+    panel: &gtk::Box,
+    game: &Game,
+    toggle: &gtk::Button,
+    mode: &gtk::Label,
+    feedback: &gtk::Label,
+    state: FlatpakMode,
+) {
+    let FlatpakMode {
+        active,
+        ready: helper_ready,
+        supported,
+    } = state;
+    panel.append(&label("Flatpak keeps the actual game inside its existing sandbox and resource limits. Install this launcher's helper, then copy the command into the game's launch settings. A blocked or canceled approval prevents that launch; it never silently runs without the requested hold."));
+    let status = label("Checking Flatpak setup…");
+    crate::widgets::announce_changes(&status);
+    panel.append(&status);
+    let command = gtk::TextView::builder()
+        .editable(false)
+        .accepts_tab(false)
+        .monospace(true)
+        .wrap_mode(gtk::WrapMode::WordChar)
+        .build();
+    command.update_property(&[gtk::accessible::Property::Label("Game wrapper command")]);
+    let prefix = omen_client::flatpak_setup::prefix(&game.id).unwrap_or_default();
+    let prefix = if game.source == GameSource::Steam {
+        format!("{prefix} %command%")
+    } else {
+        prefix
+    };
+    command.add_css_class("game-wrapper");
+    command.buffer().set_text(&prefix);
+    let instructions = match game.source {
+        GameSource::Steam => "Use this in the game's Steam Launch Options, preserving required game arguments and %command%.",
+        GameSource::Lutris => "Use this as the game's Command prefix in Lutris System options. Keep existing required game arguments.",
+        GameSource::Heroic => "Use the helper path as Heroic's wrapper executable and GAME_ID -- as its arguments. It must wrap the actual game command.",
+        _ => unreachable!(),
+    };
+    panel.append(&label(instructions));
+    panel.append(&command);
+    let actions = crate::widgets::action_row();
+    let install = gtk::Button::with_label("Install launcher helper");
+    let check = gtk::Button::with_label("Check Flatpak setup");
+    let remove = gtk::Button::with_label("Remove launcher helper");
+    let copy = gtk::Button::with_label("Copy wrapper command");
+    for button in [&install, &check, &remove, &copy] {
+        crate::widgets::append_action(&actions, button);
+    }
+    panel.append(&actions.widget);
+    let feedback_copy = feedback.clone();
+    copy.connect_clicked(move |button| {
+        button.clipboard().set_text(&prefix);
+        feedback_copy.set_text(
+            "Wrapper command copied. Configure it in the launcher, then enable automatic restore.",
+        );
+    });
+    panel.append(&label("Removing this shared helper disables automatic restore for every game in this Flatpak launcher. Remove the command prefix from those games before launching again. Running games and their holds continue; Release profile hold ends a hold now. Sandbox permissions are managed separately in your desktop's Flatpak settings."));
+    let busy = Rc::new(std::cell::Cell::new(false));
+    let refresh: Rc<dyn Fn(SetupAction)> = Rc::new({
+        let id = game.id.clone();
+        let panel = panel.downgrade();
+        // Signals own refresh; keep its button references weak so recycled
+        // library rows can release their setup widgets after a worker finishes.
+        let buttons = [install.downgrade(), check.downgrade(), remove.downgrade()];
+        let toggle = toggle.clone();
+        let mode = mode.clone();
+        let status = status.clone();
+        let feedback = feedback.clone();
+        let active = active.clone();
+        move |action| {
+            let Some(buttons) = buttons
+                .iter()
+                .map(|button| button.upgrade())
+                .collect::<Option<Vec<_>>>()
+            else {
+                return;
+            };
+            if busy.replace(true) {
+                return;
+            }
+            for button in &buttons {
+                button.set_sensitive(false);
+            }
+            toggle.set_sensitive(false);
+            status.set_text("Checking Flatpak setup…");
+            let (tx, rx) = std::sync::mpsc::channel();
+            let id = id.clone();
+            std::thread::spawn(move || {
+                let result = match action {
+                    SetupAction::Check => omen_client::flatpak_setup::status(&id),
+                    SetupAction::Install => omen_client::flatpak_setup::install(&id),
+                    SetupAction::Remove => omen_client::flatpak_setup::remove(&id),
+                };
+                let _ = tx.send(result);
+            });
+            let panel = panel.clone();
+            let buttons = buttons.clone();
+            let toggle = toggle.clone();
+            let mode = mode.clone();
+            let status = status.clone();
+            let feedback = feedback.clone();
+            let active = active.clone();
+            let helper_ready = helper_ready.clone();
+            let busy = busy.clone();
+            gtk::glib::timeout_add_local(Duration::from_millis(100), move || {
+                if panel.upgrade().is_none() {
+                    return gtk::glib::ControlFlow::Break;
+                }
+                match rx.try_recv() {
+                    Ok(result) => {
+                        busy.set(false);
+                        for button in &buttons {
+                            button.set_sensitive(true);
+                        }
+                        match result {
+                            Ok(state) => {
+                                helper_ready.set(state.ready);
+                                if matches!(action, SetupAction::Remove) {
+                                    active.set(false);
+                                    toggle.set_label("Enable automatic restore");
+                                }
+                                mode.set_text(mode_message(active.get(), false));
+                                status.set_text(&state.detail);
+                                buttons[2].set_sensitive(state.helper_installed);
+                                toggle.set_sensitive(active.get() || (supported && state.ready));
+                                feedback.set_text(match action { SetupAction::Install => "Launcher helper installed. Copy its command into your game settings, then enable automatic restore.", SetupAction::Remove => "Launcher helper removed and automatic profiles disabled for this launcher. Remove its command prefix in the launcher before playing again.", SetupAction::Check => "Setup check complete. Launch-time authorization and kernel checks still apply." });
+                            }
+                            Err(error) => {
+                                helper_ready.set(false);
+                                status.set_text(&format!("Flatpak setup needs attention: {error}. Check setup again after correcting the problem."));
+                                toggle.set_sensitive(active.get());
+                            }
+                        }
+                        gtk::glib::ControlFlow::Break
+                    }
+                    Err(std::sync::mpsc::TryRecvError::Empty) => gtk::glib::ControlFlow::Continue,
+                    Err(_) => {
+                        busy.set(false);
+                        for button in &buttons {
+                            button.set_sensitive(true);
+                        }
+                        status.set_text("Setup check stopped. Use Check Flatpak setup to retry.");
+                        toggle.set_sensitive(active.get());
+                        gtk::glib::ControlFlow::Break
+                    }
+                }
+            });
+        }
+    });
+    for (button, action) in [
+        (&install, SetupAction::Install),
+        (&check, SetupAction::Check),
+        (&remove, SetupAction::Remove),
+    ] {
+        let refresh = refresh.clone();
+        button.connect_clicked(move |_| refresh(action));
+    }
+    refresh(SetupAction::Check);
