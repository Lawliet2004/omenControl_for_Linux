<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>omen-linux</vendor>
  <action id="com.omenlinux.control">
    <description>Control OMEN/Victus hardware (fans, profiles, lighting)</description>
    <message>Authentication is required to change hardware settings through omen-linux</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.omenlinux.admin">
    <description>Change omen-linux system configuration or stop the daemon</description>
    <message>Authentication is required to change omen-linux system configuration</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

</policyconfig>
