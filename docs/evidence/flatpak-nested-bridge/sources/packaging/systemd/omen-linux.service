[Unit]
Description=OMEN Linux hardware control daemon
Documentation=file:///usr/share/doc/omen-linux/INSTALLATION.md
After=polkit.service

[Service]
Type=simple
ExecStart=/usr/bin/omen-daemon
# Live fan writes are release-blocked. Never sweep unrelated hwmon devices.
Restart=on-failure
RestartSec=2
# Read-only monitoring and explicitly enabled PPD control over D-Bus.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
BindReadOnlyPaths=/sys
ProtectKernelTunables=yes
ReadWritePaths=/run/omen-linux /etc/omen-linux
RuntimeDirectory=omen-linux
RuntimeDirectoryMode=0755
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
